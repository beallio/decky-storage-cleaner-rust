{
  "name": "decky-storage-cleaner-rust",
  "type": "module",
  "version": "0.1.0",
  "description": "A plugin for tidying up your Deck's storage",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "build:backend": "cargo build --manifest-path backend-rust/Cargo.toml --release --locked --target x86_64-unknown-linux-musl",
    "package": "pnpm build && pnpm build:backend && scripts/package.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beallio/decky-storage-cleaner-rust.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "deck",
    "storage",
    "utility",
    "cleaner",
    "memory",
    "shader",
    "cache",
    "disk"
  ],
  "author": "beallio (original by Matt Carlucci)",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/beallio/decky-storage-cleaner-rust/issues"
  },
  "homepage": "https://github.com/beallio/decky-storage-cleaner-rust#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.1",
    "@decky/ui": "^4.8.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.24.0",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.2",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
