#!/usr/bin/env bash
# All checks that CI runs. Invoke from anywhere; it works from the repository root.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

manifest=backend-rust/Cargo.toml
[[ -d node_modules ]] || pnpm install --frozen-lockfile

cargo fmt --manifest-path "$manifest" --check
cargo clippy --manifest-path "$manifest" --all-targets --locked -- -D warnings
cargo test --manifest-path "$manifest" --locked

metadata="$(cargo metadata --manifest-path "$manifest" --format-version 1 --locked)"
package_field() {
  node -p "JSON.parse(require('fs').readFileSync(0)).packages.find(p => p.name === '$1').$2" <<<"$metadata"
}

# Cargo.lock follows Cargo.toml through --locked; Cargo.toml must follow package.json.
if [[ "$(package_field storage-cleaner-backend version)" != "$(node -p 'require("./package.json").version')" ]]; then
  echo "quality-gates: backend-rust/Cargo.toml version differs from package.json" >&2
  exit 1
fi

# main.py must stay a byte-identical copy of the shim from the pinned decky-plugin rev.
sdk_manifest="$(package_field decky-plugin manifest_path)"
if ! cmp -s main.py "$(dirname "$sdk_manifest")/shim/main.py"; then
  echo "quality-gates: main.py differs from the pinned decky-plugin shim" >&2
  exit 1
fi

pnpm typecheck
# Fails on a known vulnerability in JavaScript that ships in the plugin. CI also runs cargo-deny.
pnpm audit --prod
pnpm package

echo "quality-gates: OK"
